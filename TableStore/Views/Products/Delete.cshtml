@model TableStore.Models.Product

@{
    ViewData["Title"] = "Xóa Sản phẩm";
}

<h1>Xóa Sản phẩm</h1>

<h3 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này không?</h3>
<div>
    <h4>Chi tiết sản phẩm</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Giá
        </dt>
        <dd class = "col-sm-10 text-danger font-weight-bold">
            @Model.Price.ToString("N0") VNĐ
        </dd>
        <dt class = "col-sm-2">
            Mô tả
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            Hình ảnh
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 200px;" />
            }
            else
            {
                <span>Không có ảnh</span>
            }
        </dd>
    </dl>
    
    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy / Quay lại</a>
    </form>
</div>
