@model TableStore.Models.Order

@{
    ViewData["Title"] = "Hóa Đơn";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-success text-white text-center">
            <h3><i class="fas fa-check-circle"></i> Đặt hàng thành công!</h3>
            <p class="mb-0">Mã đơn hàng: #@Model.Id</p>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h5 class="mb-3">Thông tin khách hàng:</h5>
                    <div><strong>Họ tên:</strong> @Model.FullName</div>
                    <div><strong>Số điện thoại:</strong> @Model.PhoneNumber</div>
                    <div><strong>Địa chỉ:</strong> @Model.Address</div>
                    <div><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-sm-6">
                    <h5 class="mb-3">Thông tin thanh toán:</h5>
                    <div><strong>Phương thức:</strong> @Model.PaymentMethod</div>
                    <div><strong>Trạng thái:</strong> Đang chờ xử lý</div>
                </div>
            </div>

            <div class="table-responsive-sm">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th class="center">#</th>
                            <th>Sản phẩm</th>
                            <th class="right">Đơn giá</th>
                            <th class="center">Số lượng</th>
                            <th class="right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 1; }
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td class="center">@(stt++)</td>
                                <td class="left">@detail.Product?.Name</td>
                                <td class="right">@detail.Price.ToString("N0") VNĐ</td>
                                <td class="center">@detail.Quantity</td>
                                <td class="right text-danger font-weight-bold">@((detail.Price * detail.Quantity).ToString("N0")) VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-lg-4 col-sm-5 ms-auto">
                    <table class="table table-clear">
                        <tbody>
                            <tr>
                                <td class="left">
                                    <strong>Tổng tiền thanh toán</strong>
                                </td>
                                <td class="right text-danger font-weight-bold">
                                    <strong>@Model.TotalAmount.ToString("N0") VNĐ</strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>
