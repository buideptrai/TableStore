@model IEnumerable<TableStore.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Quản lý Đơn hàng</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th class="pe-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 align-middle"><strong>#@item.Id</strong></td>
                            <td class="align-middle">@item.FullName</td>
                            <td class="align-middle">@item.PhoneNumber</td>
                            <td class="align-middle">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="align-middle text-danger font-weight-bold">@item.TotalAmount.ToString("N0") VNĐ</td>
                            <td class="pe-4 text-center align-middle">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white rounded-pill px-3 mb-1">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger text-white rounded-pill px-3 mb-1" onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
